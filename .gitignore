# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
/.vite

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
# build output — the host runs `npm run build` itself; a committed dist/ is
# just a stale 31MB copy that conflicts on every merge.
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw screen-recording sources dropped at the repo root — commit the
# web-encoded mp4 in public/ instead. Scoped to the root so an intentional
# .mov under public/ still gets tracked.
/*.mov

# compiled helpers for scripts/encode-demo.sh
/scripts/.build/

# raw camera captures dropped at the repo root while swapping gallery photos —
# commit the processed assets under src/assets/projects/ instead. Scoped to the
# root so an intentional PNG elsewhere still gets tracked.
/*.png

# Design handoff packs dropped in the working tree while a round of changes is
# being implemented (website_implementation_handoff/, website_refinement_v3/).
# They are the designer's source material, not the site's: the SVGs that matter
# are carried into src/components/icons/ as geometry, and committing the packs
# would add megabytes of PNG previews the build never reads. Ignored rather
# than merely untracked so `git add -A` cannot sweep them into a commit.
/website_implementation_handoff/
/website_refinement_v3/
