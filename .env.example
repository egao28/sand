# The contact form's configuration. Copy to `.env` for local work, and set the
# same names in the host's environment for the deploy (Vercel → Settings →
# Environment Variables). `.env` is ignored by git; this file carries names
# only and never values.
#
# Everything under "required" is required. api/contact.js answers 503 to every
# submission until all of them are set, and says in the server log which ones
# are missing. There is no partial mode where the form works with some of the
# protections turned off.

# ---------------------------------------------------------------- required

# Resend. The API key is secret; `re_...`, from https://resend.com/api-keys.
RESEND_API_KEY=

# Where the form delivers. Read on the server, never sent by the browser.
CONTACT_TO_EMAIL=
# Who it is from. Must be an address on a domain verified in Resend — mail is
# never sent as the visitor, whose address becomes Reply-To instead.
# Accepts "Portfolio contact <form@yourdomain.com>".
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile, from https://dash.cloudflare.com → Turnstile.
# The SITE key is public and belongs in the bundle; the VITE_ prefix is what
# puts it there. The SECRET key is the one that can validate a token and must
# never be given a VITE_ prefix.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The shared store behind the rate limit and the duplicate guard. An Upstash
# Redis database (or the Vercel Upstash integration, which injects
# KV_REST_API_URL and KV_REST_API_TOKEN instead — either pair works).
# A serverless function has no memory between instances, so this is what makes
# a rate limit a rate limit rather than a per-instance suggestion.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- optional

# Comma-separated origins. When set, a cross-site POST that carries an Origin
# header not on the list is refused. Leave unset to skip the check.
# CONTACT_ALLOWED_ORIGINS=https://whitesandooz.vercel.app

# 'true' makes Cloudflare also check the token against the caller's IP. Off by
# default: a phone that changes network between solving and submitting would
# otherwise be refused.
# TURNSTILE_CHECK_REMOTE_IP=false

# The limits, if the defaults do not suit. Five per address per ten minutes,
# and sixty an hour across everyone.
# CONTACT_RATE_PER_IP=5
# CONTACT_RATE_WINDOW_MIN=10
# CONTACT_RATE_GLOBAL=60
